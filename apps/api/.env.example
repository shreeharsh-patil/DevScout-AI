[TEMPLATE]
# ──────────────────────────────────────────────────────────────────────────────
# DevScout AI – Backend Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite is used by default for local development.
# Set DATABASE_URL for production (PostgreSQL recommended).
#
# SQLite (local dev):
#   DATABASE_URL=sqlite:///./devscout.db
#
# PostgreSQL (production) – works with Neon, Supabase, Railway, etc.:
#   DATABASE_URL=postgresql://user:password@host:5432/devscout
#
# Note: If you see "psycopg2" errors, install psycopg2-binary:
#   pip install psycopg2-binary
DATABASE_URL=sqlite:///./devscout.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# Use * to allow all origins (NOT recommended for production).
# Examples:
#   CORS_ORIGINS=http://localhost:3000
#   CORS_ORIGINS=https://your-app.vercel.app,https://devscout.ai
CORS_ORIGINS=http://localhost:3000

# ── Redis & Job Queue ────────────────────────────────────────────────────────
# Redis connection URL for the durable research worker queue.
# If unset or unreachable, the backend gracefully falls back to local background execution.
#
# Local Redis:
#   REDIS_URL=redis://localhost:6379/0
#
# Cloud Redis (Upstash, Railway, Render, Redis Cloud):
#   REDIS_URL=rediss://default:password@host:6379/0
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=devscout-research

# ── AI / LLM API Keys ────────────────────────────────────────────────────────
# Required for full LLM analysis synthesis and insights.
GEMINI_API_KEY=

# ── Authentication ───────────────────────────────────────────────────────────
# Optional API key for authenticating research requests.
# Leave empty or unset to disable authentication.
API_SECRET_KEY=

