# ──────────────────────────────────────────────────────────────────────────────
# DevScout AI – Backend Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
APP_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite is used by default for local development.
# Set DATABASE_URL for production (PostgreSQL recommended).
#
# SQLite (local dev):
#   DATABASE_URL=sqlite:///./devscout.db
#
# PostgreSQL (production) – works with Neon, Supabase, Railway, etc.:
#   DATABASE_URL=postgresql://user:password@host:5432/devscout
DATABASE_URL=sqlite:///./devscout.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000

# ── Redis & Job Queue ────────────────────────────────────────────────────────
# Redis connection URL for the durable research worker queue.
# Production requires Redis/RQ. Local fallback is opt-in because it is not durable.
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=devscout-research
REQUIRE_QUEUE=false
ALLOW_LOCAL_QUEUE_FALLBACK=false

# ── AI / LLM API Keys ────────────────────────────────────────────────────────
# Required for full LLM analysis synthesis and insights.
GEMINI_API_KEY=

# ── Intelligence & OSINT APIs ───────────────────────────────────────────────
# Optional: GitHub Personal Access Token to raise GitHub API rate limits (60/hr -> 5,000/hr).
GITHUB_TOKEN=

# Optional: HaveIBeenPwned API Key for breach exposure auditing.
# When omitted, breach exposure checks return 'UNAVAILABLE' gracefully.
HIBP_API_KEY=

# Optional: EXA API Key for enhanced web intelligence.
EXA_API_KEY=

# ── Authentication & Security ────────────────────────────────────────────────
# Secret used for signing and verifying native JWT access tokens.
JWT_SECRET=

# Development conveniences. Production startup rejects these when enabled.
ENABLE_DEMO_AUTH=true
ENABLE_DEV_TOKEN_AUTH=true
TRUST_IDENTITY_HEADERS=false

# Optional static API key for service-to-service calls (X-API-Key header).
API_SECRET_KEY=

# Reliability, capacity, and observability controls.
REQUEST_RATE_LIMIT=120
RESEARCH_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=20
LLM_TIMEOUT_SECONDS=45
DB_CONNECT_TIMEOUT=10
DB_POOL_TIMEOUT=10
LOG_LEVEL=INFO
LOG_JSON=false
